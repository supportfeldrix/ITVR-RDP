{
  "name": "itvr-rdp",
  "productName": "ITVR RDP",
  "version": "1.0.0",
  "description": "Cross-platform RDP and SSH connection manager",
  "author": "CRO IT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node scripts/ntlm-test.js && node scripts/gateway-test.js && node scripts/store-test.js && node scripts/rdm-test.js && node scripts/sftp-test.js",
    "smoke": "vite build && node scripts/smoke-test.js",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:mac-from-win": "vite build && electron-builder --win --dir && node scripts/build-mac.js"
  },
  "build": {
    "appId": "za.co.fnb.itvr.rdp",
    "productName": "ITVR RDP",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}",
      "splashImage": "build/splash.bmp"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "fast-xml-parser": "5.12.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ssh2": "1.17.0",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "vite": "8.3.8",
    "wait-on": "9.5.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  }
}
